.venv/
__pycache__/
*.pyc
.pytest_cache/
risk_viewer_backend.egg-info/

# Build artifact (see scripts/precompute.py / app/precomputed.py):
# regenerated by every Docker image build, not meant to be committed.
app/data/precomputed/

# Downloaded third-party source models (see scripts/psha/README.md):
# large (150-350 MB per city), re-fetched by fetch_sources.py, not
# committed.
scripts/psha/_raw/

# Downloaded independent-validation source papers/theses (see
# scripts/psha/README.md and validate_independent.py): a few MB each,
# re-fetched on demand, not committed.
scripts/psha/_raw_validation/

# Downloaded rasters (see scripts/geodata/README.md): a few MB per
# country, re-fetched/streamed by the build_*.py scripts, not committed.
scripts/geodata/_raw/

# Downloaded HDX source files (see scripts/exposure/README.md): a few
# hundred MB, re-fetched by build_venezuela.py, not committed.
scripts/exposure/_raw/

